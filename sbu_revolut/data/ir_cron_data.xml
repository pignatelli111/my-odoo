<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_revolut_import" model="ir.cron">
            <field name="name">SBU Revolut: import movements</field>
            <field name="model_id" ref="model_sbu_revolut_transaction"/>
            <field name="state">code</field>
            <field name="code">model.cron_revolut_import()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
        <record id="ir_cron_revolut_payments" model="ir.cron">
            <field name="name">SBU Revolut: send approved payments and refresh status</field>
            <field name="model_id" ref="model_sbu_revolut_payment"/>
            <field name="state">code</field>
            <field name="code">model.cron_sbu_revolut_payments()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="seq_sbu_revolut_payment" model="ir.sequence">
            <field name="name">Revolut payment order</field>
            <field name="code">sbu.revolut.payment</field>
            <field name="prefix">RVP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
