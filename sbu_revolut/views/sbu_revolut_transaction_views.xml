<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sbu_revolut_transaction_list" model="ir.ui.view">
        <field name="name">sbu.revolut.transaction.list</field>
        <field name="model">sbu.revolut.transaction</field>
        <field name="arch" type="xml">
            <list string="Revolut movements" decoration-muted="state == 'ignored'" decoration-success="state == 'matched'">
                <header>
                    <button name="action_import_now" type="object" string="Import now" class="btn-secondary" display="always"/>
                    <button name="action_suggest_match" type="object" string="Suggest match" class="btn-secondary"/>
                    <button name="action_apply_suggestion" type="object" string="Apply suggestion" class="btn-secondary"/>
                    <button name="action_register_payment" type="object" string="Register payment" class="btn-primary"
                            groups="account.group_account_user"/>
                    <button name="action_sync_counterparties" type="object" string="Sync counterparties" class="btn-secondary"
                            display="always"/>
                    <button name="action_export_csv" type="object" string="Export CSV" class="btn-secondary"/>
                </header>
                <field name="transfer_date"/>
                <field name="account_id" optional="show"/>
                <field name="label"/>
                <field name="partner_id" optional="show"/>
                <field name="reference" optional="show"/>
                <field name="amount_signed" sum="Total"/>
                <field name="fee" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="revolut_type" optional="hide"/>
                <field name="revolut_state" optional="show"/>
                <field name="sbu_match_confidence" widget="badge" optional="show"
                       decoration-success="sbu_match_confidence == 'high'"
                       decoration-warning="sbu_match_confidence == 'medium'"
                       decoration-muted="sbu_match_confidence in ('low', 'none')"/>
                <field name="suggested_invoice_id" optional="hide"/>
                <field name="suggested_vendor_bill_id" optional="hide"/>
                <field name="match_invoice_id" optional="show"/>
                <field name="match_vendor_bill_id" optional="show"/>
                <field name="match_payment_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="source" optional="hide"/>
                <field name="revolut_remote_id" optional="hide"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sbu_revolut_transaction_form" model="ir.ui.view">
        <field name="name">sbu.revolut.transaction.form</field>
        <field name="model">sbu.revolut.transaction</field>
        <field name="arch" type="xml">
            <form string="Revolut movement">
                <header>
                    <button name="action_suggest_match" string="Suggest match" type="object" class="btn-secondary"
                            invisible="state != 'imported'"/>
                    <button name="action_apply_suggestion" string="Apply suggestion" type="object" class="btn-secondary"
                            invisible="state != 'imported' or (not suggested_invoice_id and not suggested_vendor_bill_id)"/>
                    <button name="action_register_payment" string="Register payment" type="object" class="btn-primary"
                            invisible="state != 'imported' or (not match_invoice_id and not suggested_invoice_id and not match_vendor_bill_id and not suggested_vendor_bill_id)"
                            groups="account.group_account_user"/>
                    <button name="action_match_odoo" string="Mark as matched" type="object" class="btn-secondary"
                            invisible="state != 'imported' or (not match_payment_id and not match_invoice_id and not match_vendor_bill_id)"/>
                    <button name="action_ignore" string="Ignore" type="object" class="btn-secondary" invisible="state != 'imported'"/>
                    <button name="action_reset_to_imported" string="Restore" type="object" class="btn-secondary" invisible="state != 'ignored'"/>
                    <field name="state" widget="statusbar" statusbar_visible="imported,matched,ignored"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="label" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="transfer_date"/>
                            <field name="amount_signed"/>
                            <field name="fee"/>
                            <field name="currency_id"/>
                            <field name="account_id"/>
                            <field name="reference"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="counterparty_name"/>
                            <field name="revolut_type"/>
                            <field name="revolut_state"/>
                            <field name="settled_at"/>
                            <field name="created_at_revolut"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Reconciliation">
                        <group>
                            <field name="sbu_match_confidence" widget="badge"/>
                            <field name="sbu_match_hint"/>
                            <field name="suggested_invoice_id" invisible="amount_signed &lt; 0"/>
                            <field name="suggested_vendor_bill_id" invisible="amount_signed &gt; 0"/>
                        </group>
                        <group>
                            <field name="match_invoice_id" invisible="amount_signed &lt; 0"/>
                            <field name="match_vendor_bill_id" invisible="amount_signed &gt; 0"/>
                            <field name="match_payment_id"/>
                            <field name="revolut_payment_id" invisible="not revolut_payment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Technical" name="technical" groups="base.group_no_one">
                            <group>
                                <field name="revolut_remote_id"/>
                                <field name="revolut_leg_id"/>
                                <field name="request_id"/>
                                <field name="counterparty_revolut_id"/>
                                <field name="source"/>
                            </group>
                            <field name="raw_json" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sbu_revolut_transaction_search" model="ir.ui.view">
        <field name="name">sbu.revolut.transaction.search</field>
        <field name="model">sbu.revolut.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="label"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <filter name="to_reconcile" string="To reconcile" domain="[('state', '=', 'imported'), ('revolut_state', '=', 'completed')]"/>
                <filter name="high" string="High confidence" domain="[('sbu_match_confidence', '=', 'high'), ('state', '=', 'imported')]"/>
                <separator/>
                <filter name="money_in" string="Money in" domain="[('amount_signed', '&gt;', 0)]"/>
                <filter name="money_out" string="Money out" domain="[('amount_signed', '&lt;', 0)]"/>
                <separator/>
                <filter name="matched" string="Matched" domain="[('state', '=', 'matched')]"/>
                <filter name="ignored" string="Ignored" domain="[('state', '=', 'ignored')]"/>
                <group>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'transfer_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sbu_revolut_transaction" model="ir.actions.act_window">
        <field name="name">Revolut movements</field>
        <field name="res_model">sbu.revolut.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sbu_revolut_transaction_search"/>
        <field name="context">{'search_default_to_reconcile': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Revolut movements yet</p>
            <p>Connect Revolut on the company form (tab Revolut (SBU)), then click "Import full history".</p>
        </field>
    </record>
</odoo>
