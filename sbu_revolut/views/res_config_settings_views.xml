<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_sbu_revolut" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sbu.revolut</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sbu_integrations.res_config_settings_view_form_inherit_sbu"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sbu_integration_block_other']" position="inside">
                <setting string="Revolut" help="Connection, accounts and payment rules are on the company form (tab Revolut (SBU)).">
                    <field name="sbu_revolut_connection_state" widget="badge"/>
                    <div class="mt-2">
                        <button name="action_revolut_open_company" type="object" string="Open Revolut setup"
                                class="btn-link" icon="oi-arrow-right" groups="account.group_account_manager"/>
                    </div>
                </setting>
                <setting string="Revolut import cron" help="Import new Revolut movements every hour.">
                    <field name="sbu_revolut_import_enabled"/>
                </setting>
                <setting string="Revolut import lookback (days)" help="How far back each scheduled import looks.">
                    <field name="sbu_revolut_import_lookback_days"/>
                    <div class="mt-2">
                        <button name="action_revolut_import_now" type="object" string="Import Revolut movements now"
                                class="btn-secondary" groups="account.group_account_user"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
