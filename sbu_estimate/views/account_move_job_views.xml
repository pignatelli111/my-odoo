<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sbu_job" model="ir.ui.view">
        <field name="name">account.move.form.sbu.job</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="sbu_job_id" invisible="1"/>
                <button name="action_sbu_open_job" type="object" class="oe_stat_button" icon="fa-building"
                        invisible="not sbu_job_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Job</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_sbu_job" model="ir.ui.view">
        <field name="name">account.move.search.sbu.job</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="sbu_job_id"/>
                <filter name="sbu_with_job" string="Linked to a job" domain="[('sbu_job_id', '!=', False)]"/>
                <filter name="sbu_group_job" string="Job" context="{'group_by': 'sbu_job_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
