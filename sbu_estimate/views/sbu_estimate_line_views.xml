<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estimate line detail form -->
    <record id="view_sbu_estimate_line_form" model="ir.ui.view">
        <field name="name">sbu.estimate.line.form</field>
        <field name="model">sbu.estimate.line</field>
        <field name="arch" type="xml">
            <form string="Riga Preventivo">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not anaco_check_warning">
                        <field name="anaco_check_warning" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="pos"/>
                            <field name="item_code"/>
                            <field name="description"/>
                            <field name="note" placeholder="es. vetro da confermare; escluso ponteggio; listino 2026…"/>
                            <field name="calc_uom_type"/>
                            <field name="cost_family"/>
                            <field name="workflow_route" readonly="1"/>
                            <field name="qty" string="H · Qt."/>
                            <field name="width_mm" string="D · B (mm)"/>
                            <field name="height_mm" string="F · H (mm)"/>
                            <field name="sqm_per_piece" string="G · MQ/Cad." readonly="1"/>
                            <field name="sqm" string="I · MQ totali" readonly="1"/>
                            <field name="uom_id"/>
                        </group>
                        <group string="Costi ANACO per pezzo (colonne Excel, CAD)">
                            <field name="price_serramento_cad" string="N · Serramento scontato"/>
                            <field name="cost_staffame_cad" string="R · Staffame (ST / LZ)"/>
                            <field name="price_accessori_cad" string="V · Accessori maniglie"/>
                            <field name="price_oscuramento_cad" string="AB · Oscuramento scontato"/>
                            <field name="cost_coibentazione_cad" string="AD · Coibentazione"/>
                            <field name="price_kit_avvolgimento_cad" string="AF · Kit avvolgimento / sistema"/>
                            <field name="price_cassonetto_cad" string="AH · Cassonetto / sistema acciaio"/>
                            <field name="price_automatismo_cad" string="AJ · Automatismo / trasf. acciaio"/>
                            <field name="price_zanzariera_cad" string="AL · Zanzariera / automatismo"/>
                            <field name="price_vetro_cad" string="AN · Vetro"/>
                            <field name="price_pannello_cad" string="AP · Pannello"/>
                            <field name="price_controtelaio_cad" string="AR · Controtelaio"/>
                            <field name="price_trasformazione_cad" string="AT · Trasformazione"/>
                            <field name="price_smontaggio_cad" string="AV · Smontaggio / posa"/>
                            <field name="cost_posa_lamiera_lin_cad" string="AX · Posa lamiera / FW finita"/>
                            <field name="price_nolo_cad" string="AZ · Nolo"/>
                        </group>
                    </group>
                    <group string="Calcolo ANACO (stesse formule del foglio Excel)">
                        <group>
                            <field name="cost_material_worked_cad" string="BB · Costo materiale lavorato e posato CAD" readonly="1"/>
                            <field name="cost_material_worked_tot" string="BC · Costo materiale lavorato e posato TOT" readonly="1"/>
                            <field name="cost_per_sqm" string="BD · Costo materiale / MQ" readonly="1"/>
                            <field name="cost_trasporto_cad" string="BE · Trasporto e imballo CAD" readonly="1"/>
                            <field name="cost_trasporto_tot" string="BF · Trasporto e imballo TOT" readonly="1"/>
                            <field name="cost_tech_pm_cad" string="BG · Sviluppo tecnico e PM CAD" readonly="1"/>
                            <field name="cost_tech_pm_tot" string="BH · Sviluppo tecnico e PM TOT" readonly="1"/>
                            <field name="cost_cantiere_cad" string="BI · Presidio cantiere CAD" readonly="1"/>
                            <field name="cost_cantiere_tot" string="BJ · Presidio cantiere TOT" readonly="1"/>
                            <field name="cost_extra_cad" string="BK · Extra CAD" readonly="1"/>
                            <field name="cost_extra_tot" string="BL · Extra TOT" readonly="1"/>
                        </group>
                        <group>
                            <field name="cost_industrial_pct" string="BM · Costi industriali %"/>
                            <field name="cost_industrial_cad" string="BN · Costi industriali CAD" readonly="1"/>
                            <field name="cost_industrial_tot" string="BO · Costi industriali TOT" readonly="1"/>
                            <field name="cost_mol_pct" string="BP · MOL %"/>
                            <field name="cost_mol_amount_cad" string="BQ · MOL CAD" readonly="1"/>
                            <field name="cost_mol_amount_tot" string="BR · MOL TOT" readonly="1"/>
                            <field name="anaco_price_cad" string="BS · Prezzo cliente CAD (calcolato)" readonly="1"/>
                            <field name="price_total_tot" string="BT · Prezzo cliente TOT" readonly="1"/>
                            <field name="price_per_sqm" string="BU · Prezzo cliente / MQ" readonly="1"/>
                            <field name="cost_total_cad" readonly="1"/>
                            <field name="cost_total_tot" readonly="1"/>
                            <field name="margin_amount" readonly="1"/>
                            <field name="margin_pct" readonly="1"/>
                        </group>
                    </group>
                    <group string="Prezzo e controllo Excel">
                        <group>
                            <field name="price_anaco_bs_cad" string="Prezzo unitario manuale (sostituisce BS)"/>
                            <field name="commission_pct"/>
                            <field name="price_total_cad" readonly="1"/>
                            <field name="unit_rate_label" readonly="1"/>
                            <field name="price_unit_rate" readonly="1"/>
                            <field name="cost_bom_total" readonly="1"/>
                        </group>
                        <group>
                            <field name="cost_anaco_bb_cad" string="BB letto da Excel"/>
                            <field name="anaco_excel_bs_cad"/>
                            <field name="cost_anaco_bc_tot" string="BC letto da Excel"/>
                            <field name="discount_sc1" string="Sconto K5 % (già in N)"/>
                            <field name="discount_sc2" string="Sconto L5 % (già in N)"/>
                            <field name="discount_sc3" string="Sconto M5 % (già in N)"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Distinta Base (ITEM)">
                            <field name="bom_line_ids">
                                <list editable="bottom"
                                      decoration-success="manual_input_pending"
                                      decoration-muted="manual_input_state == 'imported'">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="calc_type"/>
                                    <field name="width_mm_effective" optional="hide"/>
                                    <field name="height_mm_effective" optional="hide"/>
                                    <field name="sqm_per_piece_effective" optional="show"/>
                                    <field name="sqm_coverage_factor" optional="hide"/>
                                    <field name="height_adjust_mm" optional="hide"/>
                                    <field name="qty_formula_factor"/>
                                    <field name="manual_input_state" column_invisible="1"/>
                                    <field name="manual_input_pending" column_invisible="1"/>
                                    <field name="manual_dim_pending" column_invisible="1"/>
                                    <field name="needs_technical_confirm" column_invisible="1"/>
                                    <field name="dimension_display" optional="show"/>
                                    <field name="depth_mm" optional="hide"/>
                                    <field name="unit_cost"/>
                                    <field name="technical_confirmed" optional="show"
                                           decoration-warning="needs_technical_confirm and manual_input_pending and not technical_confirmed"/>
                                    <field name="data_phase" optional="show"/>
                                    <field name="pack_size"/>
                                    <field name="demand_loss_pct" optional="show"/>
                                    <field name="demand_moq" optional="show"/>
                                    <field name="qty_theoretical" readonly="1"/>
                                    <field name="qty_ordered" readonly="1"/>
                                    <field name="uom_id"/>
                                    <field name="total_cost" readonly="1"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
