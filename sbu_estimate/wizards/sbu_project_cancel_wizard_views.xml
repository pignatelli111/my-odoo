<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sbu_project_cancel_wizard_form" model="ir.ui.view">
        <field name="name">sbu.project.cancel.wizard.form</field>
        <field name="model">sbu.project.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel job">
                <div class="alert alert-info" role="alert">
                    Nothing is deleted except draft payment certificates: drafts are cancelled, the job is
                    archived and every document stays in its history. Posted invoices are cancelled with a
                    credit note, as required for Italian e-invoices.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not credit_note_count">
                    <field name="credit_note_count" class="d-inline"/> posted customer invoice(s): prepare the
                    credit notes first, check and post them in Accounting.
                    <button name="action_create_credit_notes" type="object" string="Prepare credit notes"
                            class="btn-link" groups="account.group_account_invoice"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not supplier_credit_note_count">
                    <field name="supplier_credit_note_count" class="d-inline"/> posted vendor bill(s): ask the
                    supplier for a credit note and register it when it arrives.
                </div>
                <group>
                    <field name="project_id"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0"
                          decoration-danger="action in ('credit_note', 'supplier_credit_note')"
                          decoration-muted="action == 'keep'">
                        <field name="kind"/>
                        <field name="name"/>
                        <field name="state_label"/>
                        <field name="action" widget="badge"
                               decoration-info="action in ('cancel', 'delete')"
                               decoration-warning="action in ('credit_note', 'supplier_credit_note')"/>
                        <field name="note"/>
                        <field name="res_model" column_invisible="1"/>
                        <button name="action_open_document" type="object" icon="fa-external-link" title="Open"/>
                    </list>
                </field>
                <group>
                    <field name="reason" placeholder="Why is the job cancelled? (kept in the job history)"/>
                    <field name="confirm"/>
                </group>
                <footer>
                    <button name="action_cancel_job" type="object" string="Cancel job and archive"
                            class="btn-danger" invisible="not confirm"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_project_form_sbu_cancel_job" model="ir.ui.view">
        <field name="name">project.project.form.sbu.cancel.job</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sbu_open_cancel_job_wizard" type="object" string="Cancel job"
                        groups="project.group_project_manager"
                        invisible="not sbu_estimate_id or not active"/>
            </xpath>
        </field>
    </record>
</odoo>
