<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sbu_app_review_wizard_form" model="ir.ui.view">
        <field name="name">sbu.app.review.wizard.form</field>
        <field name="model">sbu.app.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Installed apps review">
                <div class="alert alert-info" role="alert">
                    Read-only analysis: nothing is uninstalled from here. "Records entered by users" counts the data
                    people created in the app's own tables. Uninstalling an app also uninstalls everything listed in
                    "Also removed". Decide together, then uninstall from Apps (after a backup).
                </div>
                <p invisible="not candidate_count">
                    <b><field name="candidate_count" class="d-inline"/></b> app(s) look unused by SBU and hold no data.
                </p>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0"
                          decoration-success="recommendation in ('sbu', 'required')"
                          decoration-warning="recommendation == 'candidate'">
                        <field name="name"/>
                        <field name="technical_name" optional="hide"/>
                        <field name="recommendation" widget="badge"
                               decoration-success="recommendation in ('sbu', 'required')"
                               decoration-info="recommendation == 'in_use'"
                               decoration-warning="recommendation == 'candidate'"/>
                        <field name="user_records"/>
                        <field name="needed_by" optional="show"/>
                        <field name="also_removed" optional="show"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
