<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sbu_bank_statement_import_wizard_form" model="ir.ui.view">
        <field name="name">sbu.bank.statement.import.wizard.form</field>
        <field name="model">sbu.bank.statement.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import bank statement">
                <div class="alert alert-info" role="alert" invisible="result_message">
                    Export the movements from the bank's website as <b>CSV</b> (Excel "CSV" is fine) or as
                    <b>CAMT.053 (XML)</b>, then upload the file here. Lines already imported are skipped, so
                    overlapping exports are safe.
                </div>
                <group invisible="result_message">
                    <field name="journal_id" options="{'no_create': True}"/>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="auto_reconcile"/>
                </group>
                <field name="result_message" nolabel="1" invisible="not result_message"/>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"
                            invisible="result_message"/>
                    <button name="action_open_lines" type="object" string="Open bank lines" class="btn-primary"
                            invisible="not result_message"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sbu_bank_statement_import_wizard" model="ir.actions.act_window">
        <field name="name">Import bank statement (CSV / CAMT)</field>
        <field name="res_model">sbu.bank.statement.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sbu_bank_statement_import" name="Import bank statement (CSV / CAMT)"
              parent="account.menu_finance_entries" action="action_sbu_bank_statement_import_wizard"
              sequence="90" groups="account.group_account_user"/>
</odoo>
